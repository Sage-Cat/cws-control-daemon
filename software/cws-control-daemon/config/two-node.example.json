{
  "schema_version": 1,
  "listen_host": "127.0.0.1",
  "listen_port": 8765,
  "evidence_transport": "unauthenticated-udp/1",
  "decision_interval_seconds": 2.0,
  "window_seconds": 2.0,
  "freshness_seconds": 5.0,
  "minimum_frames": 4,
  "default_rate_hz": 40,
  "rssi_std_scale_dbm": 5.0,
