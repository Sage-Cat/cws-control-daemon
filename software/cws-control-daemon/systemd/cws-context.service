[Unit]
Description=Read-only network context sampler for cooperative Wi-Fi sensing
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cws-control
Group=cws-control
ExecStart=/opt/cws-control/venv/bin/cws-control context-daemon --current /var/lib/cws-control/context.json --history /var/lib/cws-control/context.ndjson --interval 10
Restart=on-failure
RestartSec=2
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cws-control
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
