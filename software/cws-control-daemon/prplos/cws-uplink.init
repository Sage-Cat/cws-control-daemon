#!/bin/sh /etc/rc.common

USE_PROCD=1
START=97
STOP=9

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/cws-uplink
    procd_set_param respawn 10 20 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/cws-uplink.conf /usr/lib/cws-udhcpc.script
    procd_close_instance
}
