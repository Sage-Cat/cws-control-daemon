#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/cws-prpl-agent
    procd_set_param respawn 5 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core="0"
    procd_set_param file /etc/cws-prpl-agent.conf /etc/cws-prpl-agent.token
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger cws-prpl-agent
}
